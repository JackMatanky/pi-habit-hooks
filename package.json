{
  "name": "pi-habit-hooks",
  "version": "1.5.0",
  "description": "Code-quality coaching engine translating lint violations into canonical smell vocabulary with AI coaching prompts — works with pi and oh-my-pi",
  "keywords": [
    "code-quality",
    "habit-hooks",
    "omp",
    "pi",
    "pi-extension",
    "pi-package",
    "rust"
  ],
  "files": [
    "dist",
    "extensions",
    "skills",
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/extensions/index.js",
  "types": "./dist/extensions/index.d.ts",
  "scripts": {
    "build": "cargo build --release && tsc -p tsconfig.build.json",
    "test": "cargo test --workspace && vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jscpd": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plus": "^1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./dist/extensions/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
