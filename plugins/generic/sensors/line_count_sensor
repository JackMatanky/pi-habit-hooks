#!/usr/bin/env node
// Reports each file's source size as tokei counts it: code lines only, so
// comments and blank lines never push a file over the threshold. Prose
// (Markdown, plain text) and file types tokei does not know count as no code.
import { execFileSync } from "node:child_process";
import fs from "node:fs";

const THRESHOLD = 500;

const files = process.argv
  .slice(2)
  .filter((file) => fs.existsSync(file) && fs.statSync(file).isFile());

const results = [];
if (files.length > 0) {
  let raw;
  try {
    // 64 MiB: one JSON report per file, and a whole repo can be scanned
    raw = execFileSync("tokei", ["--files", "--output", "json", ...files], {
      encoding: "utf-8",
      maxBuffer: 64 * 1024 * 1024,
    });
  } catch (error) {
    // a non-zero exit is an incomplete run, not a clean one
    console.error(`line_count_sensor: tokei failed: ${error.message}`);
    process.exit(1);
  }

  for (const [language, entry] of Object.entries(JSON.parse(raw))) {
    if (language === "Total") continue;
    for (const report of entry.reports) {
      results.push({
        file: report.name,
        lines: report.stats.code,
        threshold: THRESHOLD,
      });
    }
  }
}

console.log(JSON.stringify(results));
